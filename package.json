{
  "name": "qa-monster",
  "version": "1.0.0",
  "description": "Automated QA + security audit bot for mydubai-travel.com and thailand-express.com",
  "scripts": {
    "audit": "node scripts/audit.mjs",
    "audit:qa": "node scripts/audit.mjs tests/qa tests/flows",
    "audit:security": "node scripts/audit.mjs tests/security",
    "report": "node scripts/build-report.mjs",
    "dashboard": "node scripts/dashboard.mjs",
    "sync": "node scripts/sync-github.mjs",
    "zap": "node scripts/zap.mjs",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "typecheck": "tsc -p .",
    "show-report": "playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mydubaitravelil-ai/my-project.git"
  },
  "keywords": [],
