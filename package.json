  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mydubaitravelil-ai/my-project/issues"
  },
  "homepage": "https://github.com/mydubaitravelil-ai/my-project#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.56",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=20.12"
  }
}
